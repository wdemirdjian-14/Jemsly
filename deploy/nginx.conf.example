# /etc/nginx/sites-available/wazzzxpense  (nginx déjà présent sur le VPS)
# Activer :  sudo ln -s /etc/nginx/sites-available/wazzzxpense /etc/nginx/sites-enabled/
#            sudo nginx -t && sudo systemctl reload nginx
#            sudo certbot --nginx -d wazzzxpense.walautao.fr     (ajoute le HTTPS)
server {
    listen 80;
    listen [::]:80;
    server_name wazzzxpense.walautao.fr;

    client_max_body_size 25m;

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;   # lecture des relevés PDF par l'IA
    }
}
