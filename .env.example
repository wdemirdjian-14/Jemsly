# Copier en .env puis remplir :  cp .env.example .env
# Compte de connexion principal (identifiant + mot de passe long et unique).
# D'autres accès (ex. Laura) se créent ensuite dans Paramètres › Utilisateurs.
# Mot de passe oublié : changez APP_PASSWORD ici puis relancez ./scripts/deploy.sh
APP_USERNAME=warren
APP_PASSWORD=change-moi
# Clé de signature des sessions : générer avec  openssl rand -hex 32
SECRET_KEY=
# Domaine servi par Caddy
DOMAIN=wazzzxpense.walautao.fr
# Optionnel : active la lecture des relevés PDF et l'analyse IA du mois
# (clé sur https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Modèle Claude utilisé (par défaut claude-opus-5-5)
# CLAUDE_MODEL=claude-opus-5-5
# Port local de l'app (nginx fait proxy_pass vers 127.0.0.1:APP_PORT)
APP_PORT=8765
